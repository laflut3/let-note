# App local ports (optional)
BACKEND_PORT=8081
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8081/api
VITE_SITE_URL=http://localhost:5173

# Vault runtime
VAULT_ADDR=http://vault.default.svc.cluster.local:8200
VAULT_KV_MOUNT=secret

# Deployment token (used by deploy-app.sh)
# You can set VAULT_APP_TOKEN directly, or use VAULT_TOKEN as fallback.
VAULT_APP_TOKEN=CHANGE_ME_VAULT_APP_TOKEN
# VAULT_TOKEN=CHANGE_ME_VAULT_TOKEN

# Vault secret path per environment (optional)
VAULT_SECRET_PATH_DEV=let-note/dev
VAULT_SECRET_PATH_STAGING=let-note/staging
VAULT_SECRET_PATH_PROD=let-note/prod

# Image selection (optional if using config-let-note.toml)
LET_NOTE_VERSION=1.0.0
LET_NOTE_ARCH=amd64

# Deploy script timeout
WAIT_TIMEOUT=180s
