# =========================================
# Let-Note K8s unified deployment settings
# =========================================

# Image versioning
LET_NOTE_VERSION=1.0.0
LET_NOTE_ARCH=amd64
WAIT_TIMEOUT=180s

# Vault connectivity (for vault sync phase)
VAULT_ADDR=http://vault.default.svc.cluster.local:8200
VAULT_KV_MOUNT=secret
VAULT_K8S_NAMESPACE=default
VAULT_K8S_POD=vault-0

# Token used to WRITE env secrets in Vault
VAULT_ADMIN_TOKEN=CHANGE_ME_VAULT_ADMIN_TOKEN

# Token injected into Kubernetes secret/vault-app-auth
VAULT_APP_TOKEN=CHANGE_ME_VAULT_APP_TOKEN

# Vault paths by env
VAULT_SECRET_PATH_DEV=let-note/dev
VAULT_SECRET_PATH_STAGING=let-note/staging
VAULT_SECRET_PATH_PROD=let-note/prod

# ----------------
# DEV
# ----------------
PS_BDD_SERVER_DEV=postgres
PS_BDD_DB_DEV=let_note_dev
PS_BDD_USER_DEV=let_note
PS_BDD_PASS_DEV='CHANGE_ME_STRONG_DB_PASSWORD_DEV'
PS_BDD_PORT_DEV=5432
JWT_SECRET_DEV='CHANGE_ME_LONG_RANDOM_SECRET_DEV'
COOKIE_SECURE_DEV=false
S3_ENDPOINT_DEV=http://seaweed-s3.dev.svc.cluster.local:8333
S3_REGION_DEV=us-east-1
S3_BUCKET_DEV=let-note-files-dev
S3_ACCESS_KEY_DEV=CHANGE_ME_S3_ACCESS_KEY_DEV
S3_SECRET_KEY_DEV=CHANGE_ME_S3_SECRET_KEY_DEV

# ----------------
# STAGING
# ----------------
PS_BDD_SERVER_STAGING=postgres
PS_BDD_DB_STAGING=let_note_staging
PS_BDD_USER_STAGING=let_note
PS_BDD_PASS_STAGING='CHANGE_ME_STRONG_DB_PASSWORD_STAGING'
PS_BDD_PORT_STAGING=5432
JWT_SECRET_STAGING='CHANGE_ME_LONG_RANDOM_SECRET_STAGING'
COOKIE_SECURE_STAGING=true
S3_ENDPOINT_STAGING=http://seaweed-s3.staging.svc.cluster.local:8333
S3_REGION_STAGING=us-east-1
S3_BUCKET_STAGING=let-note-files-staging
S3_ACCESS_KEY_STAGING=CHANGE_ME_S3_ACCESS_KEY_STAGING
S3_SECRET_KEY_STAGING=CHANGE_ME_S3_SECRET_KEY_STAGING

# ----------------
# PROD
# ----------------
PS_BDD_SERVER_PROD=postgres
PS_BDD_DB_PROD=let_note_prod
PS_BDD_USER_PROD=let_note
PS_BDD_PASS_PROD='CHANGE_ME_STRONG_DB_PASSWORD_PROD'
PS_BDD_PORT_PROD=5432
JWT_SECRET_PROD='CHANGE_ME_LONG_RANDOM_SECRET_PROD'
COOKIE_SECURE_PROD=true
S3_ENDPOINT_PROD=http://seaweed-s3.prod.svc.cluster.local:8333
S3_REGION_PROD=us-east-1
S3_BUCKET_PROD=let-note-files-prod
S3_ACCESS_KEY_PROD=CHANGE_ME_S3_ACCESS_KEY_PROD
S3_SECRET_KEY_PROD=CHANGE_ME_S3_SECRET_KEY_PROD
