# Vault runtime
VAULT_ADDR=http://vault.vault.svc.cluster.local:8200
VAULT_TOKEN=CHANGE_ME_VAULT_TOKEN
VAULT_KV_MOUNT=secret

# DEV
VAULT_SECRET_PATH_DEV=let-note/dev
PS_BDD_SERVER_DEV=postgres.dev.svc.cluster.local
PS_BDD_DB_DEV=let_note_dev
PS_BDD_USER_DEV=let_note
PS_BDD_PASS_DEV=CHANGE_ME_STRONG_DB_PASSWORD_DEV
PS_BDD_PORT_DEV=5432
JWT_SECRET_DEV=CHANGE_ME_LONG_RANDOM_SECRET_DEV
COOKIE_SECURE_DEV=false
S3_ENDPOINT_DEV=http://seaweed-s3.storage.svc.cluster.local:8333
S3_REGION_DEV=us-east-1
S3_BUCKET_DEV=let-note-files-dev
S3_ACCESS_KEY_DEV=CHANGE_ME_S3_ACCESS_KEY_DEV
S3_SECRET_KEY_DEV=CHANGE_ME_S3_SECRET_KEY_DEV

# STAGGING
VAULT_SECRET_PATH_STAGGING=let-note/stagging
PS_BDD_SERVER_STAGGING=postgres.stagging.svc.cluster.local
PS_BDD_DB_STAGGING=let_note_stagging
PS_BDD_USER_STAGGING=let_note
PS_BDD_PASS_STAGGING=CHANGE_ME_STRONG_DB_PASSWORD_STAGGING
PS_BDD_PORT_STAGGING=5432
JWT_SECRET_STAGGING=CHANGE_ME_LONG_RANDOM_SECRET_STAGGING
COOKIE_SECURE_STAGGING=true
S3_ENDPOINT_STAGGING=http://seaweed-s3.storage.svc.cluster.local:8333
S3_REGION_STAGGING=us-east-1
S3_BUCKET_STAGGING=let-note-files-stagging
S3_ACCESS_KEY_STAGGING=CHANGE_ME_S3_ACCESS_KEY_STAGGING
S3_SECRET_KEY_STAGGING=CHANGE_ME_S3_SECRET_KEY_STAGGING

# PROD
VAULT_SECRET_PATH_PROD=let-note/prod
PS_BDD_SERVER_PROD=postgres.prod.svc.cluster.local
PS_BDD_DB_PROD=let_note_prod
PS_BDD_USER_PROD=let_note
PS_BDD_PASS_PROD=CHANGE_ME_STRONG_DB_PASSWORD_PROD
PS_BDD_PORT_PROD=5432
JWT_SECRET_PROD=CHANGE_ME_LONG_RANDOM_SECRET_PROD
COOKIE_SECURE_PROD=true
S3_ENDPOINT_PROD=http://seaweed-s3.storage.svc.cluster.local:8333
S3_REGION_PROD=us-east-1
S3_BUCKET_PROD=let-note-files-prod
S3_ACCESS_KEY_PROD=CHANGE_ME_S3_ACCESS_KEY_PROD
S3_SECRET_KEY_PROD=CHANGE_ME_S3_SECRET_KEY_PROD
